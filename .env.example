# Local fake mode. These values are safe development defaults.
GMESSAGES_AUTH_MODE=test
GMESSAGES_MODE=fake
GMESSAGES_ACCESS_TEAM_DOMAIN=https://local-development.invalid
GMESSAGES_ACCESS_AUDIENCE=local-development
GMESSAGES_IPC_TOKEN=local-dev-ipc-token
GMESSAGES_SESSION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Production requires real values for all Access and secret settings.
# GMESSAGES_AUTH_MODE=access
# GMESSAGES_MODE=real
# GMESSAGES_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# GMESSAGES_ACCESS_AUDIENCE=your-access-application-audience
# GMESSAGES_IPC_TOKEN=<generated private token>
# GMESSAGES_SESSION_KEY=<raw 32 bytes encoded with unpadded base64>
